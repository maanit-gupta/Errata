# Secrets: never commit env files. Only the .env.example templates are tracked.
.env
.env.*
!.env.example

# Dependencies and virtualenvs
node_modules/
.venv/
__pycache__/
*.py[cod]

# Build output and tool caches
.next/
out/
dist/
coverage/
.coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log

# Model caches (never commit)
.models/
model_cache/
fastembed_cache/

# Eval cache and test artefacts
eval/.cache/
test-results/
playwright-report/
*.tsbuildinfo

# Local tooling state
.vercel/
supabase/.temp/
.claude/settings.local.json

# macOS
.DS_Store

# Demo video build output (apps/web/video-src): renders and HyperFrames caches stay local.
apps/web/video-src/composition/renders/
apps/web/video-src/composition/.hyperframes/

# Scratch notes and spent drafts: keep them local, never in the tree.
# Project docs (README, CLAUDE.md, PROGRESS.md, docs/*, prompts, eval reports) stay tracked.
*.txt
!requirements*.txt
!**/public/robots.txt
NOTES.md
TODO.md
*.notes.md
*.scratch.md
scratch/
docs/ui-redesign/PR.md
docs/ui-redesign/README-rename-notes.md
