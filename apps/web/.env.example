# apps/web/.env.local — names only. Validated at startup by lib/env.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=            # server only; lib/supabase/admin.ts only
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_DEMO_MODE=          # true enables the demo role switcher; false in any real deploy
DISCORD_WEBHOOK_URL=
RESEND_API_KEY=                 # optional; blank = email disabled
EMAIL_FROM=
WORKER_URL=                    # optional: worker base URL, pinged on submit to wake a sleeping free-tier host
