# apps/worker/.env — names only. Validated at startup by brandlens_worker/settings.py.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
DATABASE_URL=                   # session pooler URI in cloud
PGMQ_QUEUE=
LLM_PROVIDER=                   # groq | gemini
LLM_FALLBACK_PROVIDER=          # groq | gemini | none
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL_TEXT=
GROQ_MODEL_VISION=
GEMINI_MODEL_TEXT=
GEMINI_MODEL_VISION=
EMBEDDING_MODEL=
MODEL_CACHE_DIR=
OCR_ENGINE=                     # paddle | tesseract
LANGFUSE_HOST=                  # https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
DISCORD_WEBHOOK_URL=            # optional: worker posts "needs review" messages
SITE_URL=                       # optional: web base URL for links in notifications
ENV=
LOG_LEVEL=
